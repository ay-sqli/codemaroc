# Copie ce fichier en .env.local (local) ou renseigne ces variables sur Vercel.
# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nom de la base
MONGODB_DB=codemaroc
# Secret des sessions : 48 caractères aléatoires (node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))")
AUTH_SECRET=
